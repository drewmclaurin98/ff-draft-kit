      ".validate": "newData.isString() && newData.val().length < 500000"
    },
    "ffdraft:pool:v1": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".validate": "newData.isString() && newData.val().length < 500000"
    },
    "ffdraft_chat_v1": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
